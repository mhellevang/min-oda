# .env er valgfritt lokalt: appen henter normalt sessionid + csrftoken direkte
# fra nettleseren din (Firefox/Chrome/Safari/Edge/Brave/...).
#
# For headless drift (NAS/server) finnes ingen innlogget nettleser. Sett da
# brukernavn + passord her, så logger appen seg inn mot Oda selv og buffrer
# sesjonen i data/session.json. Kilde-rekkefølge: manuell cookie -> passord
# -> nettleser-cookie.

# Passord-login (brukes på server der rookiepy ikke har en nettleser å lese)
ODA_USERNAME=
ODA_PASSWORD=

# Manuell cookie (DevTools -> Storage -> Cookies -> https://oda.com)
ODA_SESSIONID=
ODA_CSRFTOKEN=

# Eller hele Cookie-strengen fra "Copy as cURL":
ODA_COOKIE=

# Velg hvilken nettleser autodetekt skal bruke. Aktuelle verdier:
# firefox, chrome, safari, edge, brave, arc, opera, vivaldi, chromium,
# librewolf. Default: prøver dem i rekkefølge.
ODA_BROWSER=

# User-Agent (overstyr om Oda begynner å blokkere default)
ODA_USER_AGENT=Mozilla/5.0 (Macintosh; Intel Mac OS X 10.15; rv:128.0) Gecko/20100101 Firefox/128.0

# Cloudflare Tunnel-token (kun for server-deploy via docker-compose). Hentes
# fra Cloudflare Zero Trust -> Networks -> Tunnels. Se DEPLOY.md.
CLOUDFLARE_TUNNEL_TOKEN=

# App-passord foran hele appen (delt passord for de som skal ha tilgang).
# Tomt = av (alt åpent, greit lokalt). Sett COOKIE_SECURE=true når appen
# serveres over HTTPS (f.eks. bak Cloudflare Tunnel). SESSION_SECRET kan være
# hva som helst langt og tilfeldig; tom faller tilbake på APP_PASSWORD.
APP_PASSWORD=
SESSION_SECRET=
COOKIE_SECURE=
