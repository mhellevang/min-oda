# Kopier til .env og fyll inn. .env er gitignored.
#
# Hent fra Firefox: F12 -> Storage -> Cookies -> https://oda.com
# Vi trenger sannsynligvis disse to (Oda bruker Django session-auth):
ODA_SESSIONID=
ODA_CSRFTOKEN=

# Valgfritt: full Cookie-streng hvis du heller vil lime inn alt fra DevTools "Copy as cURL"
ODA_COOKIE=

# User-Agent fra samme nettleser (kopier fra DevTools Network -> en request -> Headers)
ODA_USER_AGENT=Mozilla/5.0 (Macintosh; Intel Mac OS X 10.15; rv:128.0) Gecko/20100101 Firefox/128.0
